# docker compose reads this file. Copy to .env, fill in, chmod 600.

# The origin host Caddy serves and gets a certificate for. A DNS-only record
# (grey cloud in Cloudflare) pointing at this box.
STUDIO_HOST=studio-origin.ratemyd.app

# The studio's public origin: what the browser's address bar says AND where
# the Modal sandbox fetches workflow bundles from. Behind the
# www.ratemyd.app/studio rewrite this is the ratemyd origin; on a subdomain
# served directly it is that subdomain.
STUDIO_ORIGIN=https://www.ratemyd.app

# Hannes's Modal deployment. Proxy Auth Token pair (wk-/ws-), not account tokens.
AUTEUR_MODAL_KEY=
AUTEUR_MODAL_SECRET=
AUTEUR_MODAL_WORKSPACE=auteur-sh
AUTEUR_MODAL_APP=auteur-harness-modal

# The one shared lock. Make the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'the password'
BASIC_AUTH_USER=studio
BASIC_AUTH_HASH=

# Optional. The card every served bundle names. Hannes's fleet is not ours:
# a100 rendered the first hosted clip (2026-09-06); b200 is available there
# and untested from here; h100 is the local default.
AUTEUR_GPU_CARD=a100

# Optional. Base url of a host that serves the Civitai LoRAs as
# <filename> + <filename>.sha256 (see bundle.server.ts, mirrorCivitai). Leave
# unset while Hannes's side fetches Civitai itself — the first clip needed no
# mirror. Never point it at a laptop: 376 MB at 0.8 Mbit/s is an hour.
# AUTEUR_MODEL_MIRROR=
