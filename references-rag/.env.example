# Image library checkout (not committed; about 2 GB): the folder holding outfits/, pose_pngs/, pose_depth/
REFS_LIBRARY_ROOT=/Users/you/work/auteur-library/nsfw-poses-references
# Content lake checkout (read-only: lexicon mining and the eval snapshot run inside its uv env)
REFS_CONTENT_LAKE_DIR=/Users/you/work/auteur-content-lake
# Writer credentials for the model-cache bucket (video-harness APP_AWS_* identity)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Dense embeddings (index build; optional at query time)
FEATHERLESS_API_KEY=
