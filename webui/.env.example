# Required by /studio/api/plan, which turns a one-line idea into a production
# brief. An xAI key — the same one the harness uses for its own agents, where
# it is named OPENAI_API_KEY because the harness reaches xAI through its
# OpenAI-compatible provider. Copy the value out of ~/auteur/.env.
XAI_API_KEY=

# Only if your harness is not at the default host.docker.internal:19006.
# AUTEUR_HARNESS_URL=http://host.docker.internal:19006
