# Required by /studio/api/plan, which turns a one-line idea into a production
# brief. Same key the harness uses (GROK_API_KEY there too) — copy the value out of ~/auteur/.env.
GROK_API_KEY=

# Only if your harness is not at the default host.docker.internal:19006.
# AUTEUR_HARNESS_URL=http://host.docker.internal:19006

# ── Hosted harness (Hannes's Modal deployment) ─────────────────────────────
# Set all three and the studio stops talking to the local container and submits
# every workspace to Modal instead: the YAML goes up whole, the workspace opens
# inside a sandbox, and every later call goes through the sandbox proxy with
# these two headers. Leave them unset for the local harness.
# Proxy Auth Token pair — `modal workspace proxy-tokens create --json` on the
# deploying side; NOT the account's MODAL_TOKEN_ID/SECRET.
# AUTEUR_MODAL_KEY=wk-...
# AUTEUR_MODAL_SECRET=ws-...
# AUTEUR_MODAL_WORKSPACE=auteur-sh
# AUTEUR_MODAL_APP=auteur-harness-modal        # optional, this is the default
#
# Hosted, the sandbox fetches each render's workflow bundle from THIS server, so
# the studio has to be reachable from the internet and say where:
# AUTEUR_STUDIO_URL=https://studio.example.com
